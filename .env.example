# whisper.rs Environment Configuration
# Copy this file to .env or export variables in your shell environment.

# Profiling & Diagnostics
# Enable detailed per-layer latency and execution timing breakdown in the transformer encoder
# Set to '1', 'true', or any non-empty value to enable profiling
WHISPER_PROFILE=1

# Server Configuration (examples/server)
# Default port and host when running whisper-server
WHISPER_HOST=127.0.0.1
WHISPER_PORT=8080

# Concurrency & Threads
# Number of threads for parallel tensor operations (defaults to physical core count)
RAYON_NUM_THREADS=4
